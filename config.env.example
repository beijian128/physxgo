# PhysX local configuration template.
# Copy this file to config.env and fill in your local paths.
# config.env is gitignored — it will NOT be committed.

# Absolute path to the PhysX 3.4 source tree root.
PHYSX_ROOT=/path/to/your/PhysX-3.4-master

# Build type: release, debug, checked, or profile
# - release: optimized, no debug symbols (default)
# - debug:   -DPX_DEBUG=1, debug visualization enabled
BUILD_TYPE=release
